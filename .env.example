# Resend — https://resend.com (maile na końcu)
# RESEND_API_KEY=re_xxx
# Jeden lub kilka adresów (przecinek):
# REPORT_TO_EMAIL=osoba1@interia.pl, osoba2@gmail.com
# REPORT_FROM_EMAIL=BTC Report <onboarding@resend.dev>
# (bez własnej domeny Resend: nadawca onboarding@resend.dev)

# Publikacja raportu jako klikalny link w mailu (bez pobierania):
# 1) Repo na GitHubie najlepiej Public (albo włącz GitHub Pages → /docs)
# 2) Token: GitHub → Settings → Developer settings → Personal access tokens
#    Uprawnienie: Contents Read and write (dla tego repo)
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=twoj-user/btc-daily-report
# GITHUB_BRANCH=main

# --- AI (wybierz jedno) ---
# Groq (darmowy tier, szybki) — https://console.groq.com
GROQ_API_KEY=gsk_xxx
AI_BASE_URL=https://api.groq.com/openai/v1
# Wnioski / fora
AI_MODEL=openai/gpt-oss-20b
# Newsy + tłumaczenia EN→PL (Qwen zwykle lepiej trzyma polski)
AI_MODEL_NEWS=qwen/qwen3.8-27b

# Albo OpenRouter zamiast Groq:
# OPENROUTER_API_KEY=sk-or-xxx
# AI_MODEL=openai/gpt-4o-mini
# AI_BASE_URL=https://openrouter.ai/api/v1

# CryptoDataAPI (darmowy tier) — netflow giełd / wieloryby
# Załóż klucz: POST https://cryptodataapi.com/api/v1/auth/keys {"email":"twoj@mail.com"}
# CRYPTODATAAPI_KEY=cdk_live_xxx

# Opcjonalnie Whale Alert — duże transfery z etykietami (exchange → wallet)
# Free tier: ~1h historii, min. ~500k USD. https://whale-alert.io / developer.whale-alert.io
# WHALE_ALERT_API_KEY=

# Opcjonalnie CoinGecko Demo API
# COINGECKO_API_KEY=

# Opcjonalnie FRED (makro US)
# FRED_API_KEY=
